#!/bin/sh
set -eu

command_name=$(basename -- "$0")
case "$command_name" in
  opentop|opentop-cli) ;;
  *) echo "OpenTop: unknown command: $command_name" >&2; exit 1 ;;
esac

case "$(uname -s)-$(uname -m)" in
  Darwin-arm64) platform=darwin-arm64 ;;
  Darwin-x86_64) platform=darwin-x64 ;;
  Linux-aarch64|Linux-arm64) platform=linux-arm64 ;;
  Linux-x86_64|Linux-amd64) platform=linux-x64 ;;
  *) echo "OpenTop: unsupported platform: $(uname -s) $(uname -m)" >&2; exit 1 ;;
esac

source_path=$0
while [ -L "$source_path" ]; do
  source_dir=$(CDPATH= cd -P -- "$(dirname -- "$source_path")" && pwd)
  link=$(readlink "$source_path")
  case "$link" in
    /*) source_path=$link ;;
    *) source_path=$source_dir/$link ;;
  esac
done
package_dir=$(CDPATH= cd -P -- "$(dirname -- "$source_path")/.." && pwd)
binary=$package_dir/native/$platform/$command_name
if [ ! -x "$binary" ]; then
  echo "OpenTop: prebuilt binary missing for $platform; reinstall opentop-rs" >&2
  exit 1
fi
exec "$binary" "$@"
